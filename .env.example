# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA compartilhe o .env nem faça commit dele (já está no .gitignore).

# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcional — modelo usado para gerar o texto (padrão: gpt-4o)
OPENAI_MODEL=gpt-5.5-2026-04-23

# Opcional — só necessário se quiser gerar audiobooks.
# Obtenha em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de uma voz em portugues da sua conta ElevenLabs (Voice Library -> copiar Voice ID)
ELEVENLABS_VOICE_ID=

# Opcional — só necessário se quiser usar fotos reais (banco de imagens) em vez de IA.
# Obtenha gratis em https://www.pexels.com/api/ (aprovação automática)
PEXELS_API_KEY=

# Opcional — só necessário para os ebooks pesquisarem de verdade na internet durante a
# geração (usado em todos os ebooks, mas é o coração dos Ebooks Técnicos/Comportamentais).
# Obtenha gratis (tem cota grátis mensal) em https://app.tavily.com
TAVILY_API_KEY=

# Login do app (usuario/senha fixos, só para voce)
APP_USERNAME=marcos
APP_PASSWORD=troque-esta-senha

# String aleatoria longa, só para assinar a sessao (pode gerar qualquer texto aleatorio)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

SERVER_PORT=3001

# Publicação automática no Sambu Online (https://ebooks.41tech.cloud) quando o
# ebook é finalizado. Sem as três variáveis abaixo, o app só avisa no log e
# segue — a exportação nunca falha por causa disso.
#  - banco do Sambu Online (NÃO é o mesmo do Sambu Ebooks): use a string externa
#    ao rodar da sua máquina; senha com caractere especial precisa ser codificada
SAMBU_ONLINE_DATABASE_URL=
#  - Supabase Storage, onde ficam EPUB, capa e áudio do site
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — bucket (padrão: sambu)
SUPABASE_STORAGE_BUCKET=
# Opcional — 0 desliga a publicação automática sem tirar as credenciais
# (o botão "Publicar na comunidade", na tela do ebook, continua funcionando)
SAMBU_ONLINE_AUTO_PUBLISH=

# Opcional — endereço do catálogo público mostrado no menu "Vitrine"
# (padrão: https://ebooks.41tech.cloud/)
VITE_VITRINE_URL=

# Opcional — 0 impede que ESTE servidor retome, ao subir, os livros que estavam
# em geração. Use 0 na máquina local: o banco é o mesmo da VPS, e sem isso o app
# local retoma os livros que a produção está escrevendo. Na VPS, deixe vazio.
RETOMAR_GERACOES_NO_BOOT=

# Opcional — chave alternativa de autenticação para chamadas automatizadas (n8n, scripts),
# sem usar login/senha. Envie no header "X-Automation-Key". Gere com algo como:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_API_KEY=

# Postgres. Duas strings diferentes, NAO intercambiaveis:
#  - no EasyPanel (app em runtime): host INTERNO do servico, porta 5432
#  - na sua maquina (npm run db:schema): host EXTERNO e a porta mapeada
# Se a senha tiver "@", escape como %40 — ou gere so com letras, numeros, - e _
DATABASE_URL=
