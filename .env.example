# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA compartilhe o .env nem faça commit dele (já está no .gitignore).

# Obtenha em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional — só necessário se quiser gerar audiobooks.
# Obtenha em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de uma voz em portugues da sua conta ElevenLabs (Voice Library -> copiar Voice ID)
ELEVENLABS_VOICE_ID=

# Login do app (usuario/senha fixos, só para voce)
APP_USERNAME=marcos
APP_PASSWORD=troque-esta-senha

# String aleatoria longa, só para assinar a sessao (pode gerar qualquer texto aleatorio)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

PORT=3001
